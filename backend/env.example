# =====================================================================
# Food Supply Network - Backend Environment Configuration Example
# Copy this file to .env (do NOT commit .env with real credentials)
# =====================================================================

# Server Configuration
PORT=3001

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
# For local dev: http://localhost:5173
# For production: https://your-frontend.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (Aiven MySQL)
DB_HOST=your-mysql-service.l.aivencloud.com
DB_PORT=22633
DB_USER=fsn_app
DB_PASSWORD=your_strong_password_here
DB_NAME=food_supply_network

# SSL Certificate for Aiven MySQL:
# Option 1 (Cloud / Render): Paste the full CA certificate text below (including BEGIN/END CERTIFICATE)
DB_CA_CERT=
# Option 2 (Local Development): Path to the ca.pem file on disk
DB_CA_PATH=./ca.pem

# Authentication (Minimum 32 characters long random string)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Email Service (SMTP - Optional, for password reset and verification codes)
# If using Gmail, generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Food Supply Network" <your-email@gmail.com>
